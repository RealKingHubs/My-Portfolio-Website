    <div class="project-grid">
      {% for project in projects | slice(0, 3) %}
      <article class="project-card">
        {% if project.icon.type === "img" %}
          <img class="card-icon brand-mark brand-mark-project" src="{{ project.icon.src }}" alt="{{ project.icon.alt }}" aria-hidden="true" />
        {% else %}
          <i class="{{ project.icon.class }} card-icon" aria-hidden="true"></i>
        {% endif %}
        <h3>{{ project.title }}</h3>
        <p class="project-lead">{{ project.lead }}</p>
        <div class="card-stack">
          {% for tech in project.stack | slice(0, 4) %}<span>{{ tech }}</span>{% endfor %}
        </div>
        <div class="card-links">
          {% for link in project.links %}
            {% if link.github %}
              <a href="{{ link.href }}" target="_blank" rel="noopener noreferrer" class="link-muted">
                <i class="fab fa-github" aria-hidden="true"></i> Repository
              </a>
            {% elif link.accent %}
              <a href="{{ link.href }}" target="_blank" rel="noopener noreferrer" class="link-accent">
                Project write-up <span aria-hidden="true">&rarr;</span>
              </a>
            {% endif %}
          {% endfor %}

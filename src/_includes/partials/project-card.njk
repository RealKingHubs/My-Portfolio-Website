{# Renders a single project card. Call with: set project = projects[n], then include this partial. #}
<article
  id="{{ project.id }}"
  class="project-card project-card-expandable{% if project.featured %} featured{% endif %}{% if project.defaultOpen %} is-open{% endif %}"
  data-tags="{{ project.tags | join(',') }}"
>
  <div class="card-header">
    {% if project.icon.type === "img" %}
      <img class="card-icon brand-mark brand-mark-project" src="{{ project.icon.src }}" alt="{{ project.icon.alt }}" aria-hidden="true" />
    {% else %}
      <i class="{{ project.icon.class }} card-icon" aria-hidden="true"></i>
    {% endif %}
    {% if project.featured %}<span class="featured-badge">Featured</span>{% endif %}
  </div>

  <h3>{{ project.title }}</h3>

  {% if project.images.length %}
  <div class="project-visual-frame">
    {% for img in project.images %}
      <img
        src="{{ img.src }}"
        alt="{{ img.alt }}"
        class="project-img zoomable-img"
        loading="lazy"
        decoding="async"
      />
    {% endfor %}
  </div>
  {% endif %}

  <p class="project-lead">{{ project.lead }}</p>

  <div class="card-stack">
    {% for tech in project.stack %}<span>{{ tech }}</span>{% endfor %}
  </div>

  <div class="project-details{% if project.defaultOpen %} open{% endif %}">
    {{ project.body | safe }}

    {% if project.outcomesTitle %}
    <h4 class="project-subtitle">{{ project.outcomesTitle }}</h4>
    {% endif %}
    {% if project.outcomes.length %}
    <ul class="card-outcomes">
      {% for item in project.outcomes %}<li>{{ item }}</li>{% endfor %}
    </ul>
    {% endif %}

    <div class="card-links">
      {% for link in project.links %}
        {% if link.github %}
          <a href="{{ link.href }}" target="_blank" rel="noopener" class="link-muted">
            <i class="fab fa-github" aria-hidden="true"></i> {{ link.label }}
          </a>
        {% elif link.accent %}
          <a href="{{ link.href }}" target="_blank" rel="noopener" class="link-accent">
            {{ link.label }} <span aria-hidden="true">&rarr;</span>
          </a>
        {% else %}
          <a href="{{ link.href }}" target="_blank" rel="noopener" class="link-muted">{{ link.label }}</a>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <button class="project-toggle-btn" type="button" aria-expanded="{{ 'true' if project.defaultOpen else 'false' }}">
    {% if project.defaultOpen %}
      Collapse Project <i class="fas fa-chevron-up"></i>
    {% else %}
      Expand Project <i class="fas fa-chevron-down"></i>
    {% endif %}
  </button>
</article>
